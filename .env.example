# このファイルをコピーして .env を作り、実際のキーを入れる
# .env は .gitignore 済み。コミットしないこと。

# --- STT（文字起こし） ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- LLM（要約・タスク抽出） ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Identity-linked API keyを使う場合に、Claude ConsoleのWorkspace IDを指定する
ANTHROPIC_WORKSPACE_ID=
# 利用するClaudeモデル名（例: Claude Platformで利用可能なSonnetモデル）
CLAUDE_MODEL=

# --- 出力先 ---
# Markdown を書き出すディレクトリ（リポジトリルートからの相対パス）
NOTES_DIR=notes

# --- 録音 ---
# 録音ファイルへ書き出す単位（秒）。文字起こしは録音全体をまとめて行う
RECORDING_CHUNK_SECONDS=15
