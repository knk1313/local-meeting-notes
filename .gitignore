# --- 環境変数 ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
backend/.build/

# --- Node / フロントエンド ---
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.local
meeting-recorder-mock.html

# --- 音声ファイル（処理後に破棄する想定だが、保持オプション時の混入を防ぐ） ---
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.webm
audio/
recordings/
!backend/app/audio/
!backend/app/audio/**
backend/app/audio/__pycache__/
backend/app/audio/**/*.pyc

# --- 録音データ（音声チャンク・文字起こしの中間ファイル） ---
data/*
!data/.gitkeep

# --- 生成された会議ノート ---
notes/*
!notes/.gitkeep

# --- エディタ / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# --- Claude Code (個人ローカル設定 / MCP 認証情報) ---
.claude/settings.local.json
.claude/.credentials.json
